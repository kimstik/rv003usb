# Host-side blobs for the WG015 bootloader: assembled standalone, shipped to
# the device scratchpad by wg015hostcli.  Also generates blobs.h for the CLI.
#
#   make PREFIX=riscv64-unknown-elf-    (or riscv-none-elf-)

PREFIX  ?= riscv64-unknown-elf-
CC      := $(PREFIX)gcc
OBJCOPY := $(PREFIX)objcopy
ARCH    := -march=rv32imc_zicsr -mabi=ilp32

# Size budget: every blob must stay below the scratchpad data area at offset
# 0x120 (chunk payloads live there); blobs <= 120 B additionally fit a single
# 0xaa report, bigger ones ride a 0xab report - the CLI picks automatically.
BLOBS := blob_rescale_timings blob_erase_page blob_program_chunk \
         blob_read_chunk blob_boot_app

all : $(BLOBS:%=%.bin) size-check blobs.h

# Full link (-Ttext=0): gas emits R_RISCV_ALIGN padding that only linker
# relaxation removes - objcopy of a bare .o would keep stray nops and shift
# the fixed +4/+8/+24 offsets.
%.elf : %.S
	$(CC) $(ARCH) -nostdlib -nostartfiles -Wl,-Ttext=0,-e,0 -o $@ $<

%.bin : %.elf
	$(OBJCOPY) -O binary --only-section=.text $< $@

size-check : $(BLOBS:%=%.bin)
	@for b in $(BLOBS); do s=$$(wc -c < $$b.bin); \
		[ $$s -le 284 ] || { echo "ERROR: $$b.bin $$s B > 284 B (data area at 0x120)"; exit 1; }; done
	@wc -c $(BLOBS:%=%.bin)

blobs.h : $(BLOBS:%=%.bin)
	@{ echo "/* Generated by blobs/Makefile - do not edit. */"; \
	   for b in $(BLOBS); do \
	     echo "static const unsigned char $$b[] = {"; \
	     od -An -v -tx1 $$b.bin | \
	       awk '{ for(i=1;i<=NF;i++) printf "0x%s,", $$i; print "" }'; \
	     echo "};"; \
	   done; } > $@
	@echo "generated blobs.h"

clean :
	rm -f *.o *.elf *.bin blobs.h

.PHONY : all size-check clean
